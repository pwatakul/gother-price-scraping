# Copy this file to .env in the same directory (gother-price-code/) and
# fill in real values. docker-compose reads this file for the backend
# service; DATABASE_URL/REDIS_URL/RABBITMQ_URL are already set to point at
# the other docker-compose services and normally don't need to change.

# --- Database (set by docker-compose for the `backend` service; only
#     needed here if you run `cargo run` outside docker-compose) ---
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hotel_scraper
DATABASE_MAX_CONNECTIONS=10

# --- Redis ---
# REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=3600
PRICE_CACHE_TTL_SECONDS=3600

# --- RabbitMQ ---
# RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE_NAME=scrape_jobs

# --- SerpAPI (Method 2 scraper). Leave empty to use MockScraper. ---
SERPAPI_KEY=
SERPAPI_BASE_URL=https://serpapi.com/search

# --- Gother internal API ---
GOTHER_API_URL=
GOTHER_API_KEY=

# --- Gemini (room-type normalization + GeminiScraper price method) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- OpenAI / ChatGPT scraper (Method 1, bonus). Leave empty to skip. ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Authentication (REQ-009) ---
# REQUIRED. Signs the login session cookie; the backend refuses to start
# without it, and rejects anything shorter than 32 characters. Generate one
# with:  openssl rand -base64 48
JWT_SECRET=
# Optional. Sets the password for the seeded `admin` account on FIRST start
# only. Leave empty to get the default admin1234! (logged at WARN) and change
# it from the UI afterwards.
ADMIN_PASSWORD=

# --- Application ---
APP_HOST=0.0.0.0
APP_PORT=8080

# --- Worker ---
WORKER_CONCURRENCY=3
WORKER_RETRY_COUNT=1
POLLING_INTERVAL_MS=5000
